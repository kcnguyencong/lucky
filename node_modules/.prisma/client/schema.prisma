datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model LotteryDraw {
  id           String   @id @default(uuid())
  drawId       String   @unique // Official Draw ID / Period Number
  lotteryType  String // e.g. "MEGA_645", "POWER_655", "LOTTO_649"
  drawDate     DateTime
  numbers      String // JSON stringified array of main winning numbers e.g. "[4, 12, 19, 25, 33, 41]"
  bonusNumber  Int? // Optional bonus or jackpot special number
  jackpotPrize Float? // Estimated Jackpot prize value
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lotteryType, drawDate])
}

model NumberFrequency {
  id          String    @id @default(uuid())
  lotteryType String
  number      Int
  appearances Int       @default(0)
  lastDrawnAt DateTime?
  gapCount    Int       @default(0) // Draws elapsed since last appearance
  updatedAt   DateTime  @updatedAt

  @@unique([lotteryType, number])
}
