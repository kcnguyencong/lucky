{
  "name": "lottery-analytics-engine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npx prisma generate --schema=packages/database/prisma/schema.prisma || true",
    "vercel-build": "npm run build --workspace=packages/core && npm run build --workspace=packages/database && npm run build --workspace=apps/web",
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev:all": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=packages/scraper\"",
    "build": "npm run build --workspaces",
    "scrape": "npm run scrape --workspace=packages/scraper",
    "db:push": "npm run db:push --workspace=packages/database",
    "db:studio": "npm run db:studio --workspace=packages/database"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
